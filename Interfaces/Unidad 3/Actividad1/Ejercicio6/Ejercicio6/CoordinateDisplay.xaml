<UserControl x:Class="Ejercicio6.Controls.CoordinateDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <StackPanel>
        <TextBlock Text="{Binding Titulo, ElementName=root}" FontWeight="Bold" Margin="4"/>
        <TextBlock Text="{Binding CoordenadaX, ElementName=root, StringFormat=X: {0}}"/>
        <TextBlock Text="{Binding CoordenadaY, ElementName=root, StringFormat=Y: {0}}"/>
    </StackPanel>
</UserControl>

