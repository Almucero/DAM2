<Window x:Class="Ejercicio6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        xmlns:controls="clr-namespace:Ejercicio6.Controls">
    <Grid>
        <StackPanel Orientation="Vertical">
            <controls:CoordinateDisplay Titulo="Posición GPS" CoordenadaX="12.55" CoordenadaY="-78.10" />
            <controls:CoordinateDisplay Titulo="Posición Actual" CoordenadaX="{Binding Latitud}" CoordenadaY="{Binding Longitud}" />
        </StackPanel>
    </Grid>
</Window>
