<UserControl x:Class="Ejercicio1.Controls.ColorLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Border Background="{Binding ColorDeFondo, ElementName=root}" Padding="6" CornerRadius="4">
        <TextBlock Text="{Binding Texto, ElementName=root}" Foreground="White" VerticalAlignment="Center"/>
    </Border>
</UserControl>
