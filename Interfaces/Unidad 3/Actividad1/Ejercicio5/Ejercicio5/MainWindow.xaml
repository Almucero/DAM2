<Window x:Class="Ejercicio5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio5"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        xmlns:controls="clr-namespace:Ejercicio5.Controls">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <controls:FixedLengthInput LongitudMáxima="8" Placeholder="Escriba código postal" Valor="{Binding CodigoPostal}" /> 
            <controls:FixedLengthInput LongitudMáxima="4" Placeholder="PIN de seguridad" Valor="{Binding PINUsuario}" />
        </StackPanel>
    </Grid>
</Window>
