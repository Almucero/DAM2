<Window x:Class="Ejercicio3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        xmlns:controls="clr-namespace:Ejercicio3.Controls">
    <Grid>
        <StackPanel Orientation="Vertical">
            <controls:NumericInput Valor="{Binding Cantidad}" MaxLength="3" />
            <controls:NumericInput Valor="{Binding Stock}" MaxLength="6" />
        </StackPanel>
    </Grid>
</Window>
