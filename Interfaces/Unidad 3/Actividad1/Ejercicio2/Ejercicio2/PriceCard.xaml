<UserControl x:Class="Ejercicio2.Controls.PriceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <Border Background="PapayaWhip" Padding="12" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="{Binding Precio, ElementName=root}" FontSize="28" FontWeight="Bold" Foreground="Black"/>
            <TextBlock Text="{Binding Descripcion, ElementName=root}" FontSize="14" Foreground="Gray"/>
        </StackPanel>
    </Border>
</UserControl>