<UserControl x:Class="MiLibreriaWPF.CampoDeTextoDP"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <StackPanel>
        <TextBlock Text="{Binding Etiqueta, ElementName=root}" FontWeight="Bold"/>
        <TextBox Text="{Binding Valor, ElementName=root, Mode=TwoWay}"/>
    </StackPanel>
</UserControl>