<UserControl x:Class="LibreriaVisualFinal.Controls.VisorProgreso"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="300" d:DesignHeight="80">

    <Border Padding="10" Background="White" CornerRadius="4" BorderBrush="#CCCCCC" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="{Binding MensajeAccion, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,5"/>

            <ProgressBar Minimum="0" Maximum="100" 
                         Value="{Binding ProgresoValor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                         Height="15" Foreground="#2ECC71" BorderThickness="0"/>
        </StackPanel>
    </Border>
</UserControl>