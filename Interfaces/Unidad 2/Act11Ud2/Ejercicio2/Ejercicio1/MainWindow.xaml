<Window x:Class="Ejercicio1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio1"
        mc:Ignorable="d"
        Title="MainWindow" Height="240" Width="300">
    <Grid>
        <StackPanel Margin="16" VerticalAlignment="Top">
            <Label Name="lblQuestion" FontSize="16" FontWeight="Bold" Margin="0,0,0,10">¿Son los calvos personas de fiar?</Label>
            <RadioButton Name="radio1" GroupName="Respuestas">
                <WrapPanel>
                    <Image Source="/Images/interrogacion_azul.png" Width="16" Height="16"/>
                    <TextBlock>A) Sí</TextBlock>
                </WrapPanel>
            </RadioButton>
            <RadioButton Name="radio2" GroupName="Respuestas">
                <WrapPanel>
                    <Image Source="/Images/interrogacion_azul.png" Width="16" Height="16"/>
                    <TextBlock>B) No</TextBlock>
                </WrapPanel>
            </RadioButton>
            <RadioButton Name="radio3" GroupName="Respuestas">
                <WrapPanel>
                    <Image Source="/Images/interrogacion_azul.png" Width="16" Height="16"/>
                    <TextBlock>C) Solo los viernes</TextBlock>
                </WrapPanel>
            </RadioButton>
            <RadioButton Name="radio4" GroupName="Respuestas">
                <WrapPanel>
                    <Image Source="/Images/interrogacion_azul.png" Width="16" Height="16"/>
                    <TextBlock>D) ¿Qué?</TextBlock>
                </WrapPanel>
            </RadioButton>
            <TextBlock Name="tbStatus" Margin="0,10,0,6"/>
            <Button HorizontalAlignment="Left" Name="btnCheck" Content="Corregir" Width="100" Padding="6" Click="BtnCheck_Click"/>
        </StackPanel>
    </Grid>
    <!--Ejercicio 2:
    Mejora el ejercicio anterior configurando cada RadioButton con alguna imagen delante de la respuesta.-->
</Window>
