<Window x:Class="Ejercicio1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="¡Haz clic aquí!" FontSize="{Binding TamañoTexto}" Width="200" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click"/>
    </Grid>
    <!--Ejercicio 1: Crea una DependencyProperty para cambiar dinámicamente el tamaño del texto de un Button. 
    1. Crea una DependencyProperty llamada TamañoTexto. 
    2. Utiliza esta propiedad para modificar el tamaño de fuente de un botón al hacer clic. -->
</Window>
