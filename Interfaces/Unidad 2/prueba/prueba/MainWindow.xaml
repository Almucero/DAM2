<Window x:Class="prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prueba"
        mc:Ignorable="d"
        Title="prueba" Height="auto" Width="auto">
    <Grid>
        <StackPanel Margin="10">
            <Label Content="_Name:" Target="{Binding ElementName=txtName}"/>
            <TextBox Name="txtName" Width="200" HorizontalAlignment="Left"/>
            <Label Content="_Mail:" Target="{Binding ElementName=txtMail}"/>
            <TextBox Name="txtMail" Width="200" HorizontalAlignment="Left"/>
        </StackPanel>
    </Grid>
</Window>
