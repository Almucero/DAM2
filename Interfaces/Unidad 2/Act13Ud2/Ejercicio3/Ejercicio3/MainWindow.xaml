<Window x:Class="Ejercicio3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio3"
        mc:Ignorable="d"
        Title="MainWindow" Height="150" Width="200">
    <Grid>
        <ComboBox Width="100" Height="20">
            <ComboBoxItem Content="Rojo">
                <ComboBoxItem.ToolTip>
                    <ToolTip Content="Rojo: Color de alerta"/>
                </ComboBoxItem.ToolTip>
            </ComboBoxItem>
            <ComboBoxItem Content="Verde">
                <ComboBoxItem.ToolTip>
                    <ToolTip Content="Verde: Color de calma"/>
                </ComboBoxItem.ToolTip>
            </ComboBoxItem>
            <ComboBoxItem Content="Azul">
                <ComboBoxItem.ToolTip>
                    <ToolTip Content="Azul: Color de los mares"/>
                </ComboBoxItem.ToolTip>
            </ComboBoxItem>
        </ComboBox>
    </Grid>
</Window>
