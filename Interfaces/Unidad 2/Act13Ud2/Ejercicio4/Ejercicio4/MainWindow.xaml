<Window x:Class="Ejercicio4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio4"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="400">
    <StackPanel Margin="10" HorizontalAlignment="Center" Height="150">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 20">
            <TextBlock Text="Selecciona una fruta:" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <ComboBox Name="cmbFrutas" Width="150">
                <ComboBoxItem Content="Manzana"/>
                <ComboBoxItem Content="Naranja"/>
                <ComboBoxItem Content="Plátano"/>
            </ComboBox>
        </StackPanel>
        <Button Content="Confirmar" Width="120" Click="Confirmar_Click"/>
    </StackPanel>
</Window>
