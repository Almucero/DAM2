<Window x:Class="Ejercicio6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio6"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="300">
    <StackPanel Margin="10" HorizontalAlignment="Center" Height="200">
        <TextBlock Text="Selecciona un tema:" Margin="0 0 0 10" FontWeight="Bold"/>
        <ComboBox x:Name="cmbTemas" Width="200" SelectionChanged="cmbTemas_SelectionChanged">
            <ComboBoxItem Content="Claro">
                <ComboBoxItem.ToolTip>
                    <ToolTip Content="Fondo blanco con texto negro, ideal para luz diurna."/>
                </ComboBoxItem.ToolTip>
            </ComboBoxItem>
            <ComboBoxItem Content="Oscuro">
                <ComboBoxItem.ToolTip>
                    <ToolTip Content="Fondo negro con texto blanco, ideal para ambientes oscuros."/>
                </ComboBoxItem.ToolTip>
            </ComboBoxItem>
            <ComboBoxItem Content="Azul">
                <ComboBoxItem.ToolTip>
                    <ToolTip Content="Fondo azul con texto blanco, para un diseño moderno y limpio."/>
                </ComboBoxItem.ToolTip>
            </ComboBoxItem>
        </ComboBox>
        <TextBlock Name="txtDemo" Text="Este es un texto de prueba" Margin="0 20 0 0" FontSize="16" FontWeight="Bold"/>
    </StackPanel>
</Window>
