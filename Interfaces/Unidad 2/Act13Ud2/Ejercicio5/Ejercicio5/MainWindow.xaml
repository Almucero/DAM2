<Window x:Class="Ejercicio5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio5"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="250">
    <StackPanel Margin="10" HorizontalAlignment="Center" Height="150">
        <TextBlock Text="Introduce tu edad:" Margin="0 0 0 5"/>
        <TextBox Name="txtEdad" Width="150">
            <TextBox.ToolTip>
                <ToolTip Content="Introduce tu edad (solo números)"/>
            </TextBox.ToolTip>
        </TextBox>
        <!--Si no es con boton nada mas poner un numero salta el aviso, impidiendo poner numeros de 2 cifras o mas en el momento-->
        <Button Content="Validar" Width="100" Margin="0 10 0 0" Click="Validar_Click"/>
    </StackPanel>
</Window>
