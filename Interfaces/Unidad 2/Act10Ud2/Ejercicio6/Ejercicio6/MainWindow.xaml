<Window x:Class="Ejercicio6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio6"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="MainTextBlock" TextWrapping="Wrap" Margin="0,0,0,12">
            <Span FontWeight="Bold" Foreground="Blue">Este texto está en negrita</Span>
            <Run Text=" y " />
            <Run Text="esta parte está en cursiva" FontStyle="Italic" Foreground="Red"/>
            <Run Text="." />
            </TextBlock>
            <CheckBox Name="chkAlt" Content="Mostrar texto alternativo" Margin="0,0,0,12"/>
            <Button Content="Actualizar texto" HorizontalAlignment="Left" Click="Actualizar_Click"/>
        </StackPanel>
    </Grid>
</Window>
