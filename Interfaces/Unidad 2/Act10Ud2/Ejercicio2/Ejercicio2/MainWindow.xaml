<Window x:Class="Ejercicio2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <TextBox Name="InputTextBox" AcceptsReturn="True" TextWrapping="Wrap" Height="160" SelectionChanged="InputTextBox_SelectionChanged"/>
            <TextBox Name="OutputTextBox" IsReadOnly="True" Height="30" VerticalContentAlignment="Center" Background="#FFF0F0F0"/>
        </StackPanel>
    </Grid>
    <!--Ejercicio 2:
    Crea una ventana con un TextBox en el que puedes introducir texro. Crea otro TextBox debajo, pero que no permita escribir nada, sIno que indique “Has seleccionado XXX” donde XXX 
    es el texto seleccionado en el TextBox primero.-->
</Window>
    
