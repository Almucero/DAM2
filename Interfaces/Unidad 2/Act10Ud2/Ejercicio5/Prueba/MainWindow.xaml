<Window x:Class="Prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prueba"
        mc:Ignorable="d"
        Title="Ejercicio 5" Height="200" Width="300">
    <Grid>
        <StackPanel Margin="10">
            <Label FontWeight="Bold">Módulos que pienso aprobar</Label>
            <CheckBox Name="cbTodos" IsThreeState="True" Checked="cb_TodosHaCambiado" Unchecked="cb_TodosHaCambiado">Todos los módulos</CheckBox>
            <StackPanel Margin="10">
                <CheckBox Name="cbChile" Checked="cb_SimpleHaCambiado" Unchecked="cb_SimpleHaCambiado">Desarrollo de interfaces</CheckBox>
                <CheckBox Name="cbChampis" Checked="cb_SimpleHaCambiado" Unchecked="cb_SimpleHaCambiado">Sistemas de gestión empresarial</CheckBox>
                <CheckBox Name="cbMozzarela" Checked="cb_SimpleHaCambiado" Unchecked="cb_SimpleHaCambiado">Acceso a datos</CheckBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
