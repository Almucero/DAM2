<Window x:Class="Ejercicio9.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio9"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10">
            <Label.Content>
                <StackPanel Orientation="Vertical" Width="250">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                        <Image Source="/appicon.ico" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Información de contacto" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Content="Mostrar mensaje" Width="140" HorizontalAlignment="Left" Click="ContactButton_Click"/>
                </StackPanel>
            </Label.Content>
        </Label>
    </Grid>
</Window>
