<Window x:Class="Prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prueba"
        mc:Ignorable="d"
        Title="Prueba" Height="400" Width="800">
    <Grid>
        <Button Height="100" Width="200" Content="Hola mundo" Background="PaleVioletRed">
            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="FontSize" Value="30"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <StackPanel>
            <TextBox Name="MiTextBox" Width="100" Margin="50" Text="{Binding ElementName=MiSlider, Path=Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Slider IsSnapToTickEnabled="True" Name="MiSlider" Minimum="0" Maximum="100" Background="Aqua"/>
        </StackPanel>
        <Button Content="¡Haz clic aquí!" FontSize="{Binding TamañoTexto}" Width="200" Height="100" HorizontalAlignment="Center" VerticalAlignment="Bottom" Click="Button_Click"/>
    </Grid>
</Window>
