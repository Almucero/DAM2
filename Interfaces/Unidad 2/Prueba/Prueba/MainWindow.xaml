<Window x:Class="Prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prueba"
        mc:Ignorable="d"
        Title="Prueba" Height="200" Width="300">
    <Grid>
        <StackPanel Margin="10">
            <Label FontWeight="Bold">Agrega ingredientes a tu pizza</Label>
            <CheckBox Name="cbTodos" IsThreeState="True" Checked="cb_TodosHaCambiado" Unchecked="cb_TodosHaCambiado">Todos</CheckBox>
            <StackPanel Margin="10">
                <CheckBox Name="cbChile" Checked="cb_SimpleHaCambiado" Unchecked="cb_SimpleHaCambiado">
                    <TextBlock>Chile <Run Foreground="Red" FontWeight="Bold">Picante</Run></TextBlock>
                </CheckBox>
                <CheckBox Name="cbChampis" Checked="cb_SimpleHaCambiado" Unchecked="cb_SimpleHaCambiado">Champis</CheckBox>
                <CheckBox Name="cbMozzarela" Checked="cb_SimpleHaCambiado" Unchecked="cb_SimpleHaCambiado">Mozzarela</CheckBox>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
