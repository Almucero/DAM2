<Window x:Class="Prueba.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prueba"
        mc:Ignorable="d"
        Title="Prueba" Height="400" Width="800">
    <Grid>
        <!--Definimos las 2 columnas dentro del grid-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <!--Creamos el ListBox para agrupar los encuentros-->
        <ListBox Name="lbJuego" Grid.Column="0" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2">
                        <!--Creamos las 5 columnas dentro de este grid-->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock HorizontalAlignment="Center" Grid.Column="0" Text="{Binding Eq1}"></TextBlock>
                        <TextBlock HorizontalAlignment="Center" Grid.Column="1" Text="{Binding Puntaje1}"></TextBlock>
                        <TextBlock HorizontalAlignment="Center" Grid.Column="2" Text="{Binding Puntaje2}"></TextBlock>
                        <TextBlock HorizontalAlignment="Center" Grid.Column="3" Text="{Binding Eq2}"></TextBlock>
                        <ProgressBar Grid.Column="4" Minimum="0" Maximum="90" Value="{Binding Progreso}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Grid.Column="1" Click="Button_Click">
            <TextBlock Text="MÁS INFORMACIÓN" TextWrapping="Wrap" TextAlignment="Center"/>
        </Button>
        <StackPanel>
            <ComboBox Name="ComboBoxColores">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Fill="{Binding Name}" Width="32" Height="32" Margin="5"/>
                            <TextBlock Text="{Binding Name}" FontSize="32"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        <Button Width="150" Height="100" Content="Pulsa aquí" ToolTip="Estás sobre el botón" Click="Button_Click_1"/>
        <TextBox Width="100" ToolTip="Introduzca su edad" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center" Margin="0,265,0,0">Edad</TextBox>
    </Grid>
</Window>
