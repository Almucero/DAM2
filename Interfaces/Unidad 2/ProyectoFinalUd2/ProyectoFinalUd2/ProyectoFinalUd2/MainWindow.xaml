<Window x:Class="ProyectoFinalUd2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoFinalUd2"
        mc:Ignorable="d"
        Title="Inventario Tienda de Ropa (WPF + SQLite)" Height="650" Width="1000"
        MinHeight="500" MinWidth="800"
        FontFamily="Segoe UI">

    <!-- Definición de Estilos Globales para Botones y TextBoxes -->
    <Window.Resources>

        <!-- CORRECCIÓN DEL ERROR: Definición del IValueConverter con clave no nula -->
        <local:ColorToLighterConverter x:Key="ColorConverter"/>

        <!-- Estilo Base para TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <!-- Estilo Base para Botón -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Usa el convertidor de color referenciado con StaticResource -->
                                <Setter TargetName="ButtonBorder" Property="Background" 
                                        Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Background, 
                                                Converter={StaticResource ColorConverter}, ConverterParameter=0.1}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" 
                                        Value="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Background, 
                                                Converter={StaticResource ColorConverter}, ConverterParameter=-0.1}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F0F4F8">
        <!-- Fondo suave, requisito de diseño -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Panel Izq: Categorías -->
            <ColumnDefinition Width="*"/>
            <!-- Central: Productos (DataGrid) -->
            <ColumnDefinition Width="320"/>
            <!-- Der: Panel Edición (Ficha) -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabecera y Título -->
        <Border Grid.ColumnSpan="3" Background="#2C3E50" BorderBrush="#1C2833" BorderThickness="0,0,0,3">
            <TextBlock Text="🛍️ Sistema de Inventario - Tienda 'UD2 Fashion'" 
                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0" Foreground="White"/>
        </Border>

        <!-- COLUMNA 1: LISTADO PRINCIPAL (CATEGORÍAS) -->
        <Border Grid.Row="1" Grid.Column="0" Margin="10,15,5,15" Background="White" CornerRadius="8" Padding="10">
            <DockPanel>
                <TextBlock Text="📁 Seleccionar Categoría (1)" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#34495E"/>
                <!-- ListBox para la relación 1:N -->
                <ListBox x:Name="lstCategorias" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                         SelectionChanged="lstCategorias_SelectionChanged" FontSize="14" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- COLUMNA 2: LISTADO SECUNDARIO (PRODUCTOS) -->
        <Border Grid.Row="1" Grid.Column="1" Margin="5,15" Background="White" CornerRadius="8" Padding="10">
            <DockPanel>
                <TextBlock Text="👕 Productos Asociados (N)" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#34495E"/>

                <!-- Requisito: Barra de búsqueda/Filtro -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="🔍 Filtrar:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Normal"/>
                    <TextBox x:Name="txtBuscar" Width="250" Padding="5" TextChanged="txtBuscar_TextChanged" Background="#F8F8F8" />
                </StackPanel>

                <DataGrid x:Name="gridProductos" AutoGenerateColumns="False" IsReadOnly="True" 
                          SelectionChanged="gridProductos_SelectionChanged" FontSize="13" 
                          AlternatingRowBackground="#F0F4F8" BorderThickness="0" GridLinesVisibility="None">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Nombre}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="100"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding Stock}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- COLUMNA 3: PANEL DE EDICIÓN (CRUD) -->
        <Border Grid.Row="1" Grid.Column="2" Margin="5,15,10,15" Background="#E3F2FD" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="✍️ Ficha de Edición (CRUD)" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" Foreground="#1565C0"/>

                <TextBlock Text="Nombre del Producto:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtNombre" Tag="Nombre" Background="White"/>

                <TextBlock Text="Precio (€):" FontWeight="SemiBold"/>
                <TextBox x:Name="txtPrecio" Tag="Precio" Background="White" TextChanged="NumericTextBox_TextChanged"/>

                <TextBlock Text="Stock:" FontWeight="SemiBold"/>
                <TextBox x:Name="txtStock" Tag="Stock" Background="White" TextChanged="NumericTextBox_TextChanged"/>

                <StackPanel Margin="0,30,0,0">
                    <!-- Botón Guardar (Update/Insert) -->
                    <Button x:Name="btnGuardar" Content="✅ Guardar Cambios" Background="#2ECC71" 
                            Click="btnGuardar_Click"/>

                    <!-- Botón Eliminar -->
                    <Button x:Name="btnEliminar" Content="🗑️ Eliminar Producto" Background="#E74C3C" 
                            Click="btnEliminar_Click"/>

                    <!-- Botón Limpiar/Nuevo -->
                    <Button x:Name="btnLimpiar" Content="➕ Limpiar y Crear Nuevo" Background="#3498DB" 
                            Click="btnLimpiar_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>